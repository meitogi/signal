# @meitogi/signal relay behind your reverse proxy — copy to .env and fill in.
# Every compose file of this kit reads this one file : docker compose --env-file ../.env …

# Host name the relay answers on. Its DNS A/AAAA record points at your proxy.
# DNS only : a CDN proxy in front (Cloudflare orange cloud) cuts idle WebSockets.
RELAY_DOMAIN=relay.example.org

# Access key, sent by peers in their hello. Empty = open relay.
# Generate one : openssl rand -base64 24
RELAY_KEY=

# Docker network your proxy container is attached to (created by your proxy's setup).
PROXY_NETWORK=proxy

# The proxy's address range on that network, so the relay reads the client's real IP from
# X-Forwarded-For (per-IP caps, bans). Without it every peer looks like the proxy.
#   docker network inspect proxy -f '{{(index .IPAM.Config 0).Subnet}}'
TRUST_PROXY=

# 1 = also accept the old open protocol (clients without a room) until they migrate.
RELAY_LEGACY=0

# Traefik only : entry point and certificate resolver names from your static config.
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=letsencrypt
# Traefik only : per client IP, open WebSockets and new connections per second (burst).
TRAEFIK_INFLIGHT=10
TRAEFIK_RATE=5
TRAEFIK_RATE_BURST=20
